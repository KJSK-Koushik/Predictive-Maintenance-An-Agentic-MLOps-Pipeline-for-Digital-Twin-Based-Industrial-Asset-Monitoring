# Copy this file to .env for local use. Never commit .env.
# Values below are deliberately empty or non-secret placeholders.

APP_ENV=local
LOG_LEVEL=INFO

# Phase 2: server-side Supabase configuration
PM_RAW_BUCKET=pm-raw
PM_DERIVED_BUCKET=pm-derived
PM_LOCAL_OBJECT_ROOT=artifacts/cloud-objects
PM_POSTGRES_DSN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Phase 4: MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Phase 8: optional agent provider; leave unset until that phase
LLM_API_KEY=
