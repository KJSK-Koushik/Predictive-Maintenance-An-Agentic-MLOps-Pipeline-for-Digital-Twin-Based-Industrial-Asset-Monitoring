# Copy this file to .env for local use. Never commit .env.
# Values below are deliberately empty or non-secret placeholders.

APP_ENV=local
LOG_LEVEL=INFO

# Phase 2: server-side Supabase configuration
PM_RAW_BUCKET=pm-raw
PM_DERIVED_BUCKET=pm-derived
PM_LOCAL_OBJECT_ROOT=artifacts/cloud-objects
PM_POSTGRES_DSN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Phase 3: local Airflow only. Keep real values in ignored local configuration.
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_UI_PORT=18080
PM_CODE_REVISION=phase3-local
PM_SOURCE_SNAPSHOT_ID=

# Phase 4: MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_SUPPRESS_PRINTING_URL_TO_STDOUT=true
PM_MLFLOW_ROOT=artifacts/mlflow
PM_FEATURE_SNAPSHOT_ID=

# Phase 6: one immutable, loopback-only staging release
PM_RELEASE_ID=
PM_RELEASE_DIR=artifacts/inference-release
PM_INFERENCE_PORT=18000

# Phase 7: immutable replay monitoring; these values contain no credentials
PM_MONITORING_ROOT=artifacts/monitoring
PM_MONITORING_BUCKET=pm-derived
PM_MONITORING_POLICY_VERSION=fd001-monitor-trigger-policy-v1
PM_MONITORING_REFERENCE_ID=
PM_MONITORING_WINDOW_ID=

# Phase 8: optional agent provider; leave unset until that phase
LLM_API_KEY=
